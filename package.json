{
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "homepage": "https://valaxy.site",
  "scripts": {
    "build": "npm run build:demo",
    "build:demo": "npm -C demo run build",
    "ci:publish": "pnpm -r publish --access public --no-git-checks",
    "dev": "npm run demo",
    "demo": "npm -C demo run dev",
    "lint": "eslint .",
    "test": "vitest run",
    "travel:maps": "node theme/bin/travel-maps.mjs --root demo",
    "release": "git add -A && cd theme && pnpm exec bumpp --all",
    "typecheck": "vue-tsc --noEmit --skipLibCheck"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@maplibre/maplibre-gl-native": "catalog:",
    "@types/markdown-it": "catalog:",
    "@unocss/eslint-plugin": "catalog:",
    "bumpp": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-format": "catalog:",
    "markdown-it": "catalog:",
    "sharp": "catalog:",
    "typescript": "catalog:",
    "valaxy-theme-zaxon": "workspace:*",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
